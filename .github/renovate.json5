{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':label(dependency)',
    ':enableVulnerabilityAlertsWithAdditionalLabel(vulnerability)',
    ':semanticCommits',
    'robo9k/renovate-config:crateSemanticCommitTypeFix',
    'robo9k/renovate-config:crateLockfileSemanticCommitTypeChore',
  ],
  customManagers: [
    {
      description: 'Match `tool` version for https://github.com/taiki-e/install-action in GHA workflows',
      customType: 'regex',
      datasourceTemplate: 'crate',
      versioningTemplate: 'cargo',
      managerFilePatterns: [
        '/(^|/)\\.github/workflows/.+\\.ya?ml$/',
      ],
      matchStrings: [
        '# renovate: taiki-e\\/install-action\\s+tool: (?<depName>.+?)@(?<currentValue>.+?)\\s',
      ],
    },
  ],
  dependencyDashboard: {
    labels: [
      'dependency',
    ],
  },
  major: {
    draftPR: true,
    prBodyNotes: ':warning: MAJOR update; might require additional testing or planning to use new features',
  },
  prConcurrentLimit: 3,
  minimumReleaseAge: '14d',
  internalChecksFilter: 'strict',
}
